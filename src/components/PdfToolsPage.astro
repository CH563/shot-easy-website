---
import PdfTools from '@components/PdfTools';
import Privacy from '@components/Privacy.astro';
import LocalProcessingBlock from '@components/LocalProcessingBlock.astro';
import SeoContentBlock from '@components/SeoContentBlock.astro';
import ToolStructuredData from '@components/ToolStructuredData.astro';
import { getLang, getLocale } from '@i18n/index';
import { getToolSeoContent } from '@lib/toolSeoContent';
const { locale } = Astro.params;
const lang = getLocale(locale);
const l = getLang(locale);
const nav = l.nav;
const t = l.pdfTools || getLang('en').pdfTools;
const navTitle = nav.pdfTools?.title || 'Merge & Compress PDF';
interface FaqItem {
    question: string;
    answer: string;
}
const faqItems: FaqItem[] = t.faq || [];
const seoContent = getToolSeoContent(lang, 'pdfTools', t);
---

<div class="container py-8 relative z-10 flex-1">
    <h1 class="text-4xl text-center leading-[42px] font-bold mb-0.5 bg-gradient-to-r from-gray-600 to-gray-800 bg-clip-text text-transparent">{navTitle}</h1>
    <p class="text-slate-600 text-center mb-2">{t.tip}</p>
    <div class="pb-12 min-h-[300px]">
        <PdfTools client:only="react" ui={t.ui} />
    </div>
    <section class="mb-3 rounded-md p-4 bg-sky-100/40 text-xs [&>p]:mb-1">
        <div class="mb-1 text-sm">📄</div>
        <h2 class="text-lg font-bold mb-2">{t.online}</h2>
        <p>{t.onlineCont1}</p>
        <p>{t.onlineCont2}</p>
    </section>
    <section class="mb-3 rounded-md p-4 bg-pink-100/40 text-xs [&>p]:mb-1">
        <div class="mb-1 text-sm">🤩</div>
        <h2 class="text-lg font-bold mb-2">{t.why}</h2>
        <p>{t.whyCont1}</p>
        <p>{t.whyCont2}</p>
    </section>
    <LocalProcessingBlock />
    <SeoContentBlock content={seoContent} />
    {faqItems.length > 0 && (
        <section class="mb-3 rounded-md p-4 bg-indigo-100/40 text-xs [&>p]:mb-1">
            <div class="mb-1 text-sm">❔</div>
            <h2 class="text-lg font-bold mb-2">{t.faqTitle}</h2>
            {faqItems.map(item => (
                <div class="mb-3 last:mb-0">
                    <h3 class="font-semibold mb-1 text-sm">{item.question}</h3>
                    <p>{item.answer}</p>
                </div>
            ))}
        </section>
    )}
    <Privacy />
</div>
<ToolStructuredData
    name={t.title}
    description={t.description}
    keywords={t.keywords}
    locale={lang}
    browserRequirements="Requires a modern browser with file APIs and PDF support"
    featureList={seoContent.featureList}
/>
{faqItems.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
            "@type": "Question",
            "name": item.question,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": item.answer
            }
        }))
    })}/>
)}
