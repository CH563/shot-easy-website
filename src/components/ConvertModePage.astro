---
import ConvertTool from '@components/ConvertTool';
import Privacy from '@components/Privacy.astro';
import LocalProcessingBlock from '@components/LocalProcessingBlock.astro';
import { CONFIG } from '@lib/config';

interface ModeSection {
    title: string;
    body: string[];
}
interface FaqItem {
    question: string;
    answer: string;
}
interface Props {
    page: {
        h1: string;
        eyebrow: string;
        intro: string[];
        sections: ModeSection[];
        faq: FaqItem[];
        backLink: string;
    };
    mode: string;
    toolCopy: Record<string, unknown>;
    convertUrl: string;
    convertName: string;
}

const { page, mode, toolCopy, convertUrl, convertName } = Astro.props;
---

<div class="container py-8 relative z-10 flex-1">
    <article class="max-w-4xl mx-auto">
        <p class="text-center text-sm font-semibold text-blue-600 mb-2">{page.eyebrow}</p>
        <h1 class="text-4xl text-center leading-[42px] font-bold mb-3 bg-gradient-to-r from-gray-600 to-gray-800 bg-clip-text text-transparent">{page.h1}</h1>
        <div class="text-slate-600 text-center text-sm max-w-3xl mx-auto mb-6 [&>p]:mb-2">
            {page.intro.map(item => <p>{item}</p>)}
        </div>
        <div class="pb-10 min-h-[300px]">
            <ConvertTool client:only="react" copy={toolCopy} defaultMode={mode} />
        </div>

        {page.sections.map((section, index) => (
            <section class={`mb-3 rounded-md p-4 text-xs shadow-sm ring-1 ring-slate-200/70 [&>p]:mb-1 ${index % 2 === 0 ? 'bg-sky-100/40' : 'bg-white/75'}`}>
                <h2 class="text-lg font-bold mb-2">{section.title}</h2>
                {section.body.map(item => <p>{item}</p>)}
            </section>
        ))}

        <section class="mb-3 rounded-md p-4 bg-indigo-100/40 text-xs [&>p]:mb-1">
            <div class="mb-1 text-sm">?</div>
            <h2 class="text-lg font-bold mb-2">FAQ</h2>
            {page.faq.map(item => (
                <div class="mb-3 last:mb-0">
                    <h3 class="font-semibold mb-1 text-sm">{item.question}</h3>
                    <p>{item.answer}</p>
                </div>
            ))}
        </section>

        <section class="rounded-md p-4 bg-green-100/40 text-xs mb-3">
            <h2 class="text-lg font-bold mb-2">{page.backLink}</h2>
            <p class="mb-3">
                <a href={convertUrl} class="text-blue-600 underline">{convertName}</a>
            </p>
        </section>
    </article>
    <LocalProcessingBlock />
    <Privacy />
</div>

<script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": page.faq.map(item => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
        }
    }))
})}/>
<script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": convertName,
            "item": new URL(convertUrl, CONFIG.website).toString()
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": page.h1,
            "item": new URL(Astro.url.pathname, CONFIG.website).toString()
        }
    ]
})}/>
