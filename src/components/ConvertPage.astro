---
import ConvertTool from '@components/ConvertTool';
import Privacy from '@components/Privacy.astro';
import LocalProcessingBlock from '@components/LocalProcessingBlock.astro';
import SeoContentBlock from '@components/SeoContentBlock.astro';
import ToolStructuredData from '@components/ToolStructuredData.astro';
import { getLang, getLocale } from '@i18n/index';
import { getToolSeoContent } from '@lib/toolSeoContent';
import { convertModes } from '@lib/convertModePages';
const { locale } = Astro.params;
const lang = getLocale(locale);
const l = getLang(locale);
const nav = l.nav;
const t = l.convert;
// Locales with a stale convert copy (no tool.groups / convertersTitle / new
// modes) fall back to the English copy field by field, so /<locale>/convert/
// renders the full 20-mode directory instead of throwing on t.tool.groups.
const enConvert = getLang('en').convert;
const toolCopy = {
    ...enConvert.tool,
    ...t.tool,
    modes: { ...enConvert.tool.modes, ...(t.tool.modes || {}) },
    groups: { ...enConvert.tool.groups, ...(t.tool.groups || {}) },
};
const convertersTitle = t.convertersTitle || enConvert.convertersTitle;
const seoContent = getToolSeoContent(lang, 'convert', t);
const converterGroups = ['images', 'pdf', 'data'];
// Mode pages exist in en, ru and uk; other locales fall back to the en route.
const modePageLocales = ['ru', 'uk'];
const modeHref = (value: string) => modePageLocales.includes(locale ?? '') ? `/${locale}/convert/${value}/` : `/convert/${value}/`;
---

<div class="container py-8 relative z-10 flex-1">
    <h1 class="text-4xl text-center leading-[42px] font-bold mb-0.5 bg-gradient-to-r from-gray-600 to-gray-800 bg-clip-text text-transparent">{nav.convert.title}</h1>
    <p class="text-slate-600 text-center mb-2">{t.tip}</p>
    <div class="pb-12 min-h-[300px]">
        <ConvertTool client:only="react" copy={toolCopy} />
    </div>
    <section class="mb-3 rounded-md p-4 bg-white/75 text-xs shadow-sm ring-1 ring-slate-200/70">
        <h2 class="text-lg font-bold mb-3">{convertersTitle}</h2>
        {converterGroups.map(group => (
            <div class="mb-3 last:mb-0">
                <h3 class="font-semibold mb-2 text-sm">{toolCopy.groups[group]}</h3>
                <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
                    {convertModes.filter(item => item.group === group).map(item => (
                        <li>
                            <a href={modeHref(item.value)} class="block rounded-md px-3 py-2 bg-slate-50 ring-1 ring-slate-200/70 text-blue-600 hover:bg-sky-100/60 hover:underline">{toolCopy.modes[item.labelKey]}</a>
                        </li>
                    ))}
                </ul>
            </div>
        ))}
    </section>
    <section class="mb-3 rounded-md p-4 bg-sky-100/40 text-xs [&>p]:mb-1">
        <div class="mb-1 text-sm">🔁</div>
        <h2 class="text-lg font-bold mb-2">{t.localTitle}</h2>
        <p>{t.localCont1}</p>
        <p>{t.localCont2}</p>
    </section>
    <section class="mb-3 rounded-md p-4 bg-pink-100/40 text-xs [&>p]:mb-1">
        <div class="mb-1 text-sm">📄</div>
        <h2 class="text-lg font-bold mb-2">{t.pdfTitle}</h2>
        <p>{t.pdfCont1}</p>
        <p>{t.pdfCont2}</p>
    </section>
    <section class="mb-3 rounded-md p-4 bg-green-100/40 text-xs [&>p]:mb-1">
        <div class="mb-1 text-sm">🧰</div>
        <h2 class="text-lg font-bold mb-2">{t.supportTitle}</h2>
        <p>{t.supportCont1}</p>
        <p>{t.supportCont2}</p>
    </section>
    <LocalProcessingBlock />
    <SeoContentBlock content={seoContent} />
    <Privacy />
</div>
<ToolStructuredData
    name={t.title}
    description={t.description}
    keywords={t.keywords}
    locale={lang}
    browserRequirements="Requires HTML5 canvas support"
    featureList={seoContent.featureList}
/>
