---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import ConvertModePage from '@components/ConvertModePage.astro';
import { getConvertModePage } from '@lib/convertModePages';
import { getLang } from '@i18n/index';

const { locale } = Astro.params;
const mode = Astro.params.mode || '';
if (locale !== 'ru' && locale !== 'uk') {
    return Astro.redirect(`/convert/${mode}/`, 301);
}
const page = getConvertModePage(mode, locale);
if (!page) {
    return new Response('Not Found', { status: 404 });
}
const t = getLang(locale).convert;
const nav = getLang(locale).nav;
---

<Layout title={page.title} description={page.description} keywords={page.keywords} languageAlternates={false}>
    <main class="relative overflow-hidden min-h-screen flex flex-col">
        <Header />
        <ConvertModePage page={page} mode={mode} toolCopy={t.tool} convertUrl={`/${locale}/convert/`} convertName={nav.convert.title} />
        <Footer />
    </main>
</Layout>
